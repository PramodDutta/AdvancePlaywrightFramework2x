{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "HealCandidates",
    "type": "object",
    "required": ["candidates"],
    "additionalProperties": false,
    "properties": {
        "candidates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
                "type": "object",
                "required": ["selector", "strategy", "reasoning"],
                "additionalProperties": false,
                "properties": {
                    "selector": { "type": "string", "minLength": 2, "maxLength": 200 },
                    "strategy": { "enum": ["css", "testid", "role", "text", "label", "placeholder"] },
                    "reasoning": { "type": "string", "minLength": 10, "maxLength": 240 }
                }
            }
        }
    }
}
