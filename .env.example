TTA_ENV=qa
BASE_URL=https://app.thetestingacademy.com
QA_BASE_URL=https://app.thetestingacademy.com
STG_BASE_URL=https://stage.thetestingacademy.com
PROD_BASE_URL=https://app.thetestingacademy.com
DEV_BASE_URL=http://localhost:3000
API_BASE_URL=https://restful-booker.herokuapp.com
LOG_LEVEL=info
ATTACH_SCREENSHOTS=false
TEST_ENV=QA
TEST_AUTHOR=TTA-QA

# e2e-checkout-env.spec.ts
STANDARD_USER=standard_user
TTA_SECRET=tta_secret
CHECKOUT_ITEM_ID=test-allthethings-tshirt-red
CHECKOUT_FIRST_NAME=Pramod
CHECKOUT_LAST_NAME=Dutta
CHECKOUT_POSTAL_CODE=560001

# --- AI agent layer (src/ai) -------------------------------------------------
# Every key below is OPTIONAL. With none set, each agent returns an
# "unavailable" result, the AI report tabs stay empty, and the suite still
# passes. That is the CI path, which is why this file ships them blank.

# Provider selection. Defaults to deepseek when unset.
#   deepseek | openrouter | groq | openai | anthropic
AI_PROVIDER=deepseek
# Override the provider's default model, or its base URL for a proxy/gateway.
# AI_MODEL=deepseek-chat
# AI_BASE_URL=

# Supply only the key for the provider you selected above.
DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Set to 1 to run the demo specs that fail on purpose (FlakyDemo, RcaDemo,
# SelfHealDemo). Leave unset everywhere that a red suite would be a problem.
# AI_DEMO=1
